<!-- market_product.ejs — Market user's product list.
     Expired products are clearly marked (red badge + dimmed row).
     Market users can add, edit and delete products from here. -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Products – Discount Marketplace</title>
    <style>
        body {
            font-family: sans-serif;
            max-width: 960px;
            margin: 40px auto;
            padding: 0 16px;
        }

        /* ── Top bar ── */
        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 10px;
        }
        .topbar h1 { margin: 0; }
        .topbar-right { display: flex; gap: 10px; align-items: center; }
        .btn-add {
            padding: 8px 16px;
            background: #0077cc;
            color: #fff;
            text-decoration: none;
            border-radius: 4px;
            font-size: 0.9rem;
        }
        .btn-add:hover { background: #005fa3; }
        .btn-settings {
            padding: 8px 14px;
            background: #f0f0f0;
            color: #333;
            text-decoration: none;
            border-radius: 4px;
            font-size: 0.9rem;
            border: 1px solid #ccc;
        }
        .btn-settings:hover { background: #e0e0e0; }

        /* ── Legend ── */
        .legend {
            font-size: 0.82rem;
            color: #555;
            margin-bottom: 16px;
        }
        .badge-expired {
            display: inline-block;
            background: #e74c3c;
            color: #fff;
            font-size: 0.72rem;
            font-weight: bold;
            padding: 2px 7px;
            border-radius: 10px;
            vertical-align: middle;
        }

        /* ── Table ── */
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.9rem;
        }
        th {
            background: #f5f5f5;
            text-align: left;
            padding: 10px 12px;
            border-bottom: 2px solid #ddd;
        }
        td {
            padding: 10px 12px;
            border-bottom: 1px solid #eee;
            vertical-align: middle;
        }
        tr.expired-row { opacity: 0.55; background: #fff5f5; }

        /* ── Product image thumbnail ── */
        .thumb {
            width: 60px;
            height: 50px;
            object-fit: cover;
            border-radius: 3px;
            border: 1px solid #ddd;
        }

        /* ── Action buttons ── */
        .btn-edit,
        .btn-delete {
            padding: 5px 11px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 0.82rem;
            text-decoration: none;
            display: inline-block;
        }
        .btn-edit  { background: #f0ad00; color: #fff; }
        .btn-edit:hover  { background: #c98b00; }
        .btn-delete { background: #e74c3c; color: #fff; margin-left: 4px; }
        .btn-delete:hover { background: #c0392b; }

        /* ── Empty state ── */
        .empty { text-align: center; padding: 60px 0; color: #888; }
    </style>
</head>
<body>

    <div class="topbar">
        <h1>My Products</h1>
        <div class="topbar-right">
            <a href="/products/add" class="btn-add">+ Add product</a>
            <a href="/settings" class="btn-settings">⚙ Settings</a>
        </div>
    </div>

    <% if (products.length > 0) { %>

        <p class="legend">
            Rows marked with <span class="badge-expired">EXPIRED</span> have passed their expiration date and are not visible to consumers.
        </p>

        <table>
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Title</th>
                    <th>Stock</th>
                    <th>Normal price</th>
                    <th>Discounted price</th>
                    <th>Expiration date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% products.forEach(p => { %>
                    <tr class="<%= p.is_expired ? 'expired-row' : '' %>">

                        <td>
                            <img
                                class="thumb"
                                src="/<%= p.image_path %>"
                                alt="<%= p.title %>"
                            >
                        </td>

                        <td>
                            <%= p.title %>
                            <% if (p.is_expired) { %>
                                <span class="badge-expired">EXPIRED</span>
                            <% } %>
                        </td>

                        <td><%= p.stock %></td>

                        <td><%= Number(p.normal_price).toFixed(2) %> TL</td>

                        <td><%= Number(p.discounted_price).toFixed(2) %> TL</td>

                        <td>
                            <%= new Date(p.expiration_date).toLocaleDateString('tr-TR') %>
                        </td>

                        <td>
                            <a href="/products/edit/<%= p.id %>" class="btn-edit">Edit</a>

                            <form
                                action="/products/delete/<%= p.id %>"
                                method="POST"
                                style="display:inline;"
                                onsubmit="return confirm('Delete \'<%= p.title %>\'? This cannot be undone.');"
                            >
                                <button type="submit" class="btn-delete">Delete</button>
                            </form>
                        </td>

                    </tr>
                <% }) %>
            </tbody>
        </table>

    <% } else { %>
        <div class="empty">
            <p>You haven't added any products yet.</p>
            <a href="/products/add" class="btn-add">+ Add your first product</a>
        </div>
    <% } %>

</body>
</html>
