<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register</title>
    <style>
        fieldset {
            width: max-content;
            margin: 30px auto;
            padding: 20px;
        }

        p {
            color: red;
            text-align: center;
        }
    </style>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

  <div class="auth-page">

    <div class="auth-brand">EcoMeow</div>

    <div class="auth-card">
      <h1>Sign up</h1>

      <% if (errorMessage) { %>
        <p class="msg-error"><%= errorMessage %></p>
      <% } %>

      <form action="/signup" method="POST">

        <label for="role">I am a:</label>
        <select id="role" name="role" required>
          <option value="consumer" <%= form.role === "consumer" ? "selected" : "" %>>Customer</option>
          <option value="market"   <%= form.role === "market"   ? "selected" : "" %>>Market</option>
        </select>

        <label for="name">Name:</label>
        <input type="text" id="name" name="name" value="<%= form.name %>" required>

        <label for="email">Email:</label>
        <input type="email" id="email" name="email" value="<%= form.email %>" required>

        <label for="password">Password:</label>
        <input type="password" id="password" name="password" minlength="4" required>

        <label for="city">City:</label>
        <input type="text" id="city" name="city" value="<%= form.city %>" required>

        <label for="district">District:</label>
        <input type="text" id="district" name="district" value="<%= form.district %>" required>

        <button type="submit">Sign up</button>

      </form>
    </div>

    <div class="auth-below-link">
      Already have an account? <a href="/login">Login</a>
    </div>

  </div>
<img src="/images/marketlogo2.jpeg" alt="EcoMeow" class="site-logo">
</body>



</html>