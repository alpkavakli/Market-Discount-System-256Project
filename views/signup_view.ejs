<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register</title>
    <style>
        fieldset {
            width: max-content;
            margin: 30px auto;
            padding: 20px;
        }

        p {
            color: red;
            text-align: center;
        }
    </style>
</head>

<body>
    <p><a href="/login">Already have an account? Login</a></p>

    <% if (errorMessage) { %>
        <p style="color:red;">
            <%= errorMessage %>
        </p>
        <% } %>

            <form action="/signup" method="POST">
                <fieldset>
                    <legend>Sign up</legend>

                    <label for="role">I am a:</label>
                    <select id="role" name="role" required>
                        <option value="consumer" <%=form.role==="consumer" ? "selected" : "" %>>Customer</option>
                        <option value="market" <%=form.role==="market" ? "selected" : "" %>>Market</option>
                    </select>
                    <br><br>

                    <label for="name">Name:</label>
                    <input type="text" id="name" name="name" value="<%= form.name %>" required>
                    <br><br>

                    <label for="email">Email:</label>
                    <input type="email" id="email" name="email" value="<%= form.email %>" required>
                    <br><br>

                    <label for="password">Password:</label>
                    <input type="password" id="password" name="password" minlength="4" required>
                    <br><br>

                    <label for="city">City:</label>
                    <input type="text" id="city" name="city" value="<%= form.city %>" required>
                    <br><br>

                    <label for="district">District:</label>
                    <input type="text" id="district" name="district" value="<%= form.district %>" required>
                    <br><br>

                    <button type="submit">Sign up</button>
                </fieldset>
            </form>
</body>

</html>