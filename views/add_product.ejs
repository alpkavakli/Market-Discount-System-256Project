<!-- add_product.ejs — used for both Add and Edit product (market users only) -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof editing !== 'undefined' && editing ? 'Edit Product' : 'Add Product' %> – Discount Marketplace</title>
    <link rel="stylesheet" href="/css/style.css">
    
</head>
<body class="add-product-page">
    <div class="page-wrapper">
    <h1><%= typeof editing !== 'undefined' && editing ? 'Edit Product' : 'Add Product' %></h1>
    <div class="breadcrumb">
        <a href="/products/market">← Back to my products</a>
    </div>

    <% if (errorMessage) { %>
        <p class="error"><%= errorMessage %></p>
    <% } %>

    <%
        const isEdit   = typeof editing !== 'undefined' && editing
        const actionUrl = isEdit ? `/products/edit/${form.id}` : '/products/add'
    %>

    <form action="<%= actionUrl %>" method="POST" enctype="multipart/form-data">
        <fieldset>
            <legend><%= isEdit ? 'Edit product details' : 'New product details' %></legend>

            <label for="title">Product title</label>
            <input
                type="text"
                id="title"
                name="title"
                value="<%= form.title || '' %>"
                placeholder="e.g. Toblerone 100gr"
                required
            >

            <label for="stock">Stock (pieces)</label>
            <input
                type="number"
                id="stock"
                name="stock"
                min="1"
                value="<%= form.stock || '' %>"
                placeholder="e.g. 25"
                required
            >

            <div class="price-row">
                <div>
                    <label for="normal_price">Normal price (TL)</label>
                    <input
                        type="number"
                        id="normal_price"
                        name="normal_price"
                        min="0.01"
                        step="0.01"
                        value="<%= form.normal_price || '' %>"
                        placeholder="200.00"
                        required
                    >
                </div>
                <div>
                    <label for="discounted_price">Discounted price (TL)</label>
                    <input
                        type="number"
                        id="discounted_price"
                        name="discounted_price"
                        min="0.01"
                        step="0.01"
                        value="<%= form.discounted_price || '' %>"
                        placeholder="120.00"
                        required
                    >
                </div>
            </div>

            <label for="expiration_date">Expiration date</label>
            <input 
                type="date"
                lang="en"
                id="expiration_date"
                name="expiration_date"
                value="<%= form.expiration_date || '' %>"
                required
            >

            <!-- If editing, show current image so the user knows what's there -->
            <% if (isEdit && form.image_path) { %>
                <div class="current-image">
                    <label>Current image</label>
                    <img src="/<%= form.image_path %>" alt="Current product image">
                    <p>Upload a new image below to replace it, or leave blank to keep the current one.</p>
                </div>
            <% } %>

            <label for="image"><%= isEdit ? 'New image (optional)' : 'Product image' %></label>
            <input
                type="file"
                id="image"
                name="image"
                accept="image/*"
                <%= isEdit ? '' : 'required' %>
            >

            <button type="submit">
                <%= isEdit ? 'Save changes' : 'Add product' %>
            </button>
        </fieldset>
    </form>

    <script>
        // Client-side price validation: discounted must be less than normal
        document.querySelector('form').addEventListener('submit', function (e) {
            const normal     = parseFloat(document.getElementById('normal_price').value)
            const discounted = parseFloat(document.getElementById('discounted_price').value)
            if (!isNaN(normal) && !isNaN(discounted) && discounted >= normal) {
                e.preventDefault()
                alert('Discounted price must be less than the normal price.')
                document.getElementById('discounted_price').focus()
            }
        })
    </script>
</div>
<img src="/images/marketlogo2.jpeg" alt="EcoMeow" class="site-logo">
</body>
</html>
