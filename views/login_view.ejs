<!--When a market user logs in, all expired products in the list should be clearly marked, so that the user is aware of products that have passed their expiration date.  -->

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        fieldset {
            width: max-content;
            margin: 30px auto;
            padding: 20px;
        }

        p {
            color: red;
            text-align: center;
        }
    </style>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

  <div class="auth-page">

    <div class="auth-brand">EcoMeow</div>

    <div class="auth-card">
      <h1>Login</h1>

      <% if (errorMessage) { %>
        <p class="msg-error"><%= errorMessage %></p>
      <% } %>

      <form action="/login" method="POST">

        <label for="role">I am a:</label>
        <select id="role" name="role" required>
          <option value="consumer" <%= form.role === "consumer" ? "selected" : "" %>>Customer</option>
          <option value="market"   <%= form.role === "market"   ? "selected" : "" %>>Market</option>
        </select>

        <label for="email">Email:</label>
        <input type="email" id="email" name="email" value="<%= form.email %>" required>

        <label for="password">Password:</label>
        <input type="password" id="password" name="password" required>

        <div class="remember-row">
          <input type="checkbox" id="remember" name="remember" <%= form.remember ? "checked" : "" %>>
          <label for="remember" style="margin:0; font-weight:400;">Remember me</label>
        </div>

        <button type="submit">Login</button>

      </form>
    </div>

    <div class="auth-below-link">
      Don't have an account? <a href="/signup">Sign up</a>
    </div>

  </div>
<img src="/images/marketlogo2.jpeg" alt="EcoMeow" class="site-logo">
</body>

</html>