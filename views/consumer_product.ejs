<!-- consumer_product.ejs
     Consumer product browser:
     - Keyword search (same city only, expired excluded, district-prioritised)
     - Paginated (4 per page)
     - Days left until expiry shown
     - Add to cart via AJAX                                               -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Products – Discount Marketplace</title>
    <style>
        body {
            font-family: sans-serif;
            max-width: 860px;
            margin: 40px auto;
            padding: 0 16px;
        }

        /* ── Top bar ── */
        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 24px;
        }
        .topbar h1 { margin: 0; }
        .topbar-right { display: flex; gap: 10px; align-items: center; }
        .btn-nav {
            padding: 8px 14px;
            background: #f0f0f0;
            color: #333;
            text-decoration: none;
            border-radius: 4px;
            font-size: 0.9rem;
            border: 1px solid #ccc;
        }
        .btn-nav:hover { background: #e0e0e0; }

        /* ── Search bar ── */
        .search-form {
            display: flex;
            gap: 8px;
            margin-bottom: 20px;
        }
        .search-form input[type="text"] {
            flex: 1;
            padding: 9px 12px;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-size: 0.95rem;
        }
        .search-form button {
            padding: 9px 18px;
            background: #0077cc;
            color: #fff;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 0.95rem;
        }
        .search-form button:hover { background: #005fa3; }

        .result-info { font-size: 0.85rem; color: #666; margin-bottom: 16px; }

        /* ── Product grid ── */
        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
            gap: 18px;
            margin-bottom: 32px;
        }

        .product-card {
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            transition: box-shadow 0.15s;
        }
        .product-card:hover { box-shadow: 0 3px 10px rgba(0,0,0,0.1); }

        .product-card img {
            width: 100%;
            height: 140px;
            object-fit: cover;
        }

        .card-body { padding: 12px; flex: 1; display: flex; flex-direction: column; gap: 4px; }

        .card-title { font-weight: 700; font-size: 0.95rem; margin: 0 0 4px; }

        .card-market { font-size: 0.78rem; color: #888; }

        .card-prices {
            display: flex;
            align-items: center;
            gap: 8px;
            margin: 6px 0 4px;
        }
        .price-normal {
            font-size: 0.8rem;
            color: #aaa;
            text-decoration: line-through;
        }
        .price-discounted { font-weight: bold; color: #e63b2e; font-size: 1rem; }

        .badge-district {
            display: inline-block;
            background: #27ae60;
            color: #fff;
            font-size: 0.68rem;
            padding: 2px 6px;
            border-radius: 10px;
        }
        .days-left { font-size: 0.78rem; color: #888; }
        .days-left.urgent { color: #e63b2e; font-weight: bold; }

        .btn-add-cart {
            margin-top: auto;
            padding: 8px;
            background: #0077cc;
            color: #fff;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 0.88rem;
            width: 100%;
        }
        .btn-add-cart:hover { background: #005fa3; }
        .btn-add-cart:disabled { background: #aaa; cursor: not-allowed; }
        .btn-add-cart.added { background: #27ae60; }

        /* ── Pagination ── */
        .pagination {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 6px;
            margin-top: 8px;
        }
        .pagination a, .pagination span {
            padding: 7px 13px;
            border: 1px solid #ddd;
            border-radius: 4px;
            text-decoration: none;
            font-size: 0.88rem;
            color: #0077cc;
        }
        .pagination span.current {
            background: #0077cc;
            color: #fff;
            border-color: #0077cc;
            font-weight: bold;
        }
        .pagination span.disabled { color: #bbb; border-color: #eee; }
        .pagination a:hover { background: #f0f7ff; }

        /* ── Empty state ── */
        .empty { text-align: center; padding: 60px 0; color: #888; }

        /* ── Toast notification ── */
        #toast {
            display: none;
            position: fixed;
            bottom: 24px;
            right: 24px;
            padding: 12px 20px;
            border-radius: 6px;
            color: #fff;
            font-size: 0.9rem;
            z-index: 999;
        }
        #toast.success { background: #27ae60; }
        #toast.error   { background: #e74c3c; }
    </style>
</head>
<body>

    <!-- Top navigation bar -->
    <div class="topbar">
        <h1>Products</h1>
        <div class="topbar-right">
            <a href="/shoppingcart" class="btn-nav">🛒 My Cart</a>
            <a href="/settings" class="btn-nav">⚙ Settings</a>
        </div>
    </div>

    <!-- Search bar -->
    <form class="search-form" action="/products/consumer" method="GET">
        <input
            type="text"
            name="keyword"
            placeholder="Search products… (e.g. mag, toblerone)"
            value="<%= keyword %>"
        >
        <button type="submit">Search</button>
        <% if (keyword) { %>
            <a href="/products/consumer" class="btn-nav" style="white-space:nowrap;">✕ Clear</a>
        <% } %>
    </form>

    <!-- Result count info -->
    <p class="result-info">
        <% if (keyword) { %>
            <%= total %> result<%= total !== 1 ? 's' : '' %> for "<%= keyword %>"
            — showing page <%= page %> of <%= totalPages || 1 %>
        <% } else { %>
            Showing <%= products.length %> product<%= products.length !== 1 ? 's' : '' %> near you
            (page <%= page %> of <%= totalPages || 1 %>)
        <% } %>
    </p>

    <% if (products.length > 0) { %>

        <!-- Product cards -->
        <div class="product-grid">
            <% products.forEach(p => { %>
                <div class="product-card">
                    <img src="/<%= p.image_path %>" alt="<%= p.title %>">
                    <div class="card-body">
                        <p class="card-title"><%= p.title %></p>
                        <p class="card-market"><%= p.market_name %></p>

                        <div class="card-prices">
                            <span class="price-normal"><%= Number(p.normal_price).toFixed(2) %> TL</span>
                            <span class="price-discounted"><%= Number(p.discounted_price).toFixed(2) %> TL</span>
                        </div>

                        <% if (p.same_district) { %>
                            <span class="badge-district">📍 Your district</span>
                        <% } %>

                        <p class="days-left <%= p.days_left <= 3 ? 'urgent' : '' %>">
                            <% if (p.days_left === 0) { %>
                                Expires today!
                            <% } else if (p.days_left === 1) { %>
                                1 day left
                            <% } else { %>
                                <%= p.days_left %> days left
                            <% } %>
                        </p>

                        <button
                            class="btn-add-cart"
                            data-product-id="<%= p.id %>"
                        >
                            Add to cart
                        </button>
                    </div>
                </div>
            <% }) %>
        </div>

        <!-- Pagination -->
        <% if (totalPages > 1) { %>
            <div class="pagination">
                <% if (page > 1) { %>
                    <a href="/products/consumer?keyword=<%= encodeURIComponent(keyword) %>&page=<%= page - 1 %>">← Prev</a>
                <% } else { %>
                    <span class="disabled">← Prev</span>
                <% } %>

                <% for (let i = 1; i <= totalPages; i++) { %>
                    <% if (i === page) { %>
                        <span class="current"><%= i %></span>
                    <% } else { %>
                        <a href="/products/consumer?keyword=<%= encodeURIComponent(keyword) %>&page=<%= i %>"><%= i %></a>
                    <% } %>
                <% } %>

                <% if (page < totalPages) { %>
                    <a href="/products/consumer?keyword=<%= encodeURIComponent(keyword) %>&page=<%= page + 1 %>">Next →</a>
                <% } else { %>
                    <span class="disabled">Next →</span>
                <% } %>
            </div>
        <% } %>

    <% } else { %>
        <div class="empty">
            <% if (keyword) { %>
                <p>No products found for "<%= keyword %>".</p>
                <a href="/products/consumer">Show all products</a>
            <% } else { %>
                <p>No products available in your area right now.</p>
            <% } %>
        </div>
    <% } %>

    <!-- Toast notification -->
    <div id="toast"></div>

    <script>
        // ── Add to cart via AJAX ──────────────────────────────────────────────
        function showToast(message, type = 'success') {
            const toast = document.getElementById('toast')
            toast.textContent  = message
            toast.className    = type
            toast.style.display = 'block'
            clearTimeout(toast._timer)
            toast._timer = setTimeout(() => { toast.style.display = 'none' }, 2800)
        }

        document.querySelectorAll('.btn-add-cart').forEach(btn => {
            btn.addEventListener('click', async function () {
                const productId = this.dataset.productId
                this.disabled = true

                try {
                    const res  = await fetch('/shoppingcart/add', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ productId })
                    })
                    const data = await res.json()

                    if (data.success) {
                        this.textContent = '✓ Added'
                        this.classList.add('added')
                        showToast('Added to cart!', 'success')
                        // Re-enable after a short delay so user can add more
                        setTimeout(() => {
                            this.textContent = 'Add to cart'
                            this.classList.remove('added')
                            this.disabled = false
                        }, 1800)
                    } else {
                        showToast(data.message || 'Could not add to cart.', 'error')
                        this.disabled = false
                    }
                } catch (err) {
                    showToast('Network error. Try again.', 'error')
                    this.disabled = false
                }
            })
        })
    </script>

</body>
</html>
