<!-- Only for consumer users
(5Pts)  A consumer can add products to a shopping cart. Stored in DB, persists between sessions.
(10Pts) Consumer can update cart (remove items or change quantities), grand total shown. AJAX required.
(5Pts)  Purchase button clears cart and removes purchased products from system. AJAX required.
-->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Shopping Cart – Discount Marketplace</title>
</head>
<body>

  <h1>Shopping Cart</h1>
  <p><a href="/products">Browse products</a></p> <!-- added to browse products  -->

  <!-- Cart table — hidden via JS if it becomes empty after removals -->
  <div id="cart-container">
    <% if (typeof cartItems !== 'undefined' && cartItems.length > 0) { %>

      <table border="1" cellpadding="8" cellspacing="0">
        <thead>
          <tr>
            <th>Product</th>
            <th>Market</th>
            <th>Unit Price</th>
            <th>Quantity</th>
            <th>Subtotal</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="cart-body">
          <% cartItems.forEach(item => { %>
            <tr id="cart-row-<%= item.id %>">
              <td><%= item.title %></td>
              <td><%= item.market_name %></td>
              <td><%= Number(item.discounted_price).toFixed(2) %> TL</td>
              <td>
                <input
                  type="number"
                  min="1"
                  max="<%= item.stock %>"
                  value="<%= item.quantity %>"
                  data-cart-item-id="<%= item.id %>"
                  data-original-value="<%= item.quantity %>"
                  class="qty-input"
                />
               <span
                        id="stock-warning-<%= item.id %>"
                        style="color:red; font-size:0.8rem;"
                        <% if (item.quantity < item.stock) { %>hidden<% } %>
                        >Out of stock
                </span>
              </td>
              <td id="subtotal-<%= item.id %>">
                <%= (Number(item.discounted_price) * item.quantity).toFixed(2) %> TL
              </td>
              <td>
                <button class="btn-remove" data-cart-item-id="<%= item.id %>">Remove</button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>

      <p><strong>Grand Total: <span id="grand-total">
        <%= cartItems.reduce((sum, item) => sum + Number(item.discounted_price) * item.quantity, 0).toFixed(2) %> TL
      </span></strong></p>

      <button id="btn-purchase">Purchase</button>

    <% } else { %>
      <!-- Empty cart message — also shown dynamically via JS when last item is removed -->
      <p id="empty-msg">Your cart is empty. <a href="/products">Browse products</a></p>
    <% } %>
  </div>

  <script>
    // ── Update quantity via AJAX ──────────────────────────────────────────────
    document.querySelectorAll('.qty-input').forEach(input => {
      input.addEventListener('change', async function () {
        const cartItemId = this.dataset.cartItemId;
        const newQty = parseInt(this.value);

        // Basic client-side validation before sending
        if (isNaN(newQty) || newQty < 1) {
          this.value = this.dataset.originalValue;
          return;
        }
          if (newQty > maxStock) { //added to stock limit on client-side
          newQty = maxStock
          this.value = maxStock
        }

        const res = await fetch('/shoppingcart/update', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ cartItemId, quantity: newQty })
        });

        const data = await res.json();
        if (data.success) {
          document.getElementById(`subtotal-${cartItemId}`).textContent =
            data.subtotal.toFixed(2) + ' TL';
          document.getElementById('grand-total').textContent =
            data.grandTotal.toFixed(2) + ' TL';
          // Update original value so reverting works correctly next time
          this.dataset.originalValue = newQty;

          const warning = document.getElementById(`stock-warning-${cartItemId}`) //added to toggle stock warning 
          warning.style.display = newQty >= maxStock ? 'inline' : 'none'

        } else {
            
          alert(data.message || 'Failed to update quantity.');
          this.value = this.dataset.originalValue; // revert to last known good value
        }
      });
    });

    // ── Remove item via AJAX ──────────────────────────────────────────────────
    document.querySelectorAll('.btn-remove').forEach(btn => {
      btn.addEventListener('click', async function () {
        const cartItemId = this.dataset.cartItemId;

        const res = await fetch('/shoppingcart/remove', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ cartItemId })
        });

        const data = await res.json();
        if (data.success) {
          // Remove the row from the table
          document.getElementById(`cart-row-${cartItemId}`).remove();

          const remaining = document.querySelectorAll('#cart-body tr');
          if (remaining.length === 0) {
            // Cart is now empty — hide table and show empty message
            showEmptyCart();
          } else {
            document.getElementById('grand-total').textContent =
              data.grandTotal.toFixed(2) + ' TL';
          }
        } else {
          alert(data.message || 'Failed to remove item.');
        }
      });
    });

    // ── Purchase via AJAX ─────────────────────────────────────────────────────
    const purchaseBtn = document.getElementById('btn-purchase');
    if (purchaseBtn) {
      purchaseBtn.addEventListener('click', async function () {
        if (!confirm('Confirm purchase?')) return;

        const res = await fetch('/shoppingcart/purchase', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });

        const data = await res.json();
        if (data.success) {
          alert('Purchase successful!');
          showEmptyCart(); // clear UI without reloading
        } else {
          alert(data.message || 'Purchase failed.');
        }
      });
    }

    // ── Helper: swap table for empty message ──────────────────────────────────
    function showEmptyCart() {
      document.getElementById('cart-container').innerHTML =
        '<p id="empty-msg">Your cart is empty. <a href="/products">Browse products</a></p>';
    }
  </script>

</body>
</html>
