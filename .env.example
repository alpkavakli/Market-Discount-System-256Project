DB_PORT=3306 #Abi ben 3306'da kullanıyorum siz 3307 yaparsınız. Onun yerine dockerda gereksiz containerları kapasanız siz de 3306 kullansanız daha mantıklı olabilir 
DB_USER=std
DB_PASSWORD=std
DB_NAME=test

